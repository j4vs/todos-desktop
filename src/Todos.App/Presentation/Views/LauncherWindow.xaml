<Window x:Class="Todos.Presentation.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:Todos.Presentation.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=object}"
        Title="Todo's"
        Width="52"
        Height="52"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource TodosFontFamily}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        automation:AutomationProperties.Name="Todo's, control principal"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TodosTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource TodosFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="11">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosPressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TodosFocusBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosBrandHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosBrandPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenToggleStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="12,0" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                </Grid.ColumnDefinitions>
                                <controls:SvgIcon Width="15" Height="15" Source="Assets/Icons/eye-slashed.svg"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding HiddenTitle}" FontFamily="{StaticResource TodosFontFamily}" />
                                <controls:SvgIcon Grid.Column="2" Width="11" Height="7"
                                                  Source="Assets/Icons/chevron.svg"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <controls:SvgIcon.RenderTransform>
                                        <RotateTransform Angle="90" />
                                    </controls:SvgIcon.RenderTransform>
                                </controls:SvgIcon>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosPressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TodosFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsHiddenSubmenuOpen}" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosHoverSurfaceBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#6E5CC4" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenListButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TodosTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosPressedSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HiddenDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TodosDangerBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosPressedSurfaceBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="LauncherSurface" Focusable="True"
                KeyboardNavigation.TabNavigation="Continue" Background="Transparent"
                BorderThickness="0" CornerRadius="17" Cursor="Hand"
                automation:AutomationProperties.Name="Abrir menú de Todo's"
                automation:AutomationProperties.HelpText="Presiona Enter para abrir el menú o Control más N para crear una lista"
                ToolTip="Todo's — clic para abrir; arrastra para mover"
                PreviewMouseLeftButtonDown="OnLauncherMouseDown"
                PreviewMouseMove="OnLauncherMouseMove"
                PreviewMouseLeftButtonUp="OnLauncherMouseUp">
            <Image Source="/Todos;component/Assets/icon.png" Stretch="Uniform"
                   SnapsToDevicePixels="True" IsHitTestVisible="False" />
        </Border>

        <Popup x:Name="MenuPopup" PlacementTarget="{Binding ElementName=LauncherSurface}"
               IsOpen="{Binding IsMenuOpen, Mode=TwoWay}" Placement="Custom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="264" Padding="12" Background="{StaticResource TodosPopupBrush}"
                    BorderBrush="#16000000" BorderThickness="1" CornerRadius="19">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.24" Color="#302A3D" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Margin="10,5,10,9" Text="Todo's"
                               Foreground="{StaticResource TodosTextBrush}"
                               FontSize="18" FontWeight="SemiBold" />
                    <Button Style="{StaticResource MenuButtonStyle}" Tag="Primary"
                            Command="{Binding CreateListCommand}" Background="{StaticResource TodosBrandBrush}"
                            Foreground="White">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:SvgIcon Width="14" Height="14" Source="Assets/Icons/plus.svg" Foreground="White" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Nueva lista" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ShowAllCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:SvgIcon Width="15" Height="13" Source="Assets/Icons/eye.svg"
                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Mostrar todas" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding HideAllCommand}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:SvgIcon Width="15" Height="15" Source="Assets/Icons/eye-slashed.svg"
                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Ocultar todas" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="HiddenListsButton" Style="{StaticResource HiddenToggleStyle}"
                            Command="{Binding ToggleHiddenSubmenuCommand}"
                            IsEnabled="{Binding HasHiddenWindows}"
                            automation:AutomationProperties.Name="Abrir submenú de listas ocultas" />
                    <Separator Margin="8,8,8,5" Background="#EBE7EF" />
                    <CheckBox Margin="10,5" MinHeight="34" VerticalContentAlignment="Center"
                              IsChecked="{Binding RunAtWindowsStartup}" Content="Iniciar Todo's con Windows"
                              Foreground="{StaticResource TodosTextBrush}" FontSize="12.5"
                              ToolTip="Activa o desactiva el inicio automático" />
                    <Button Style="{StaticResource MenuButtonStyle}" Command="{Binding ExitCommand}"
                            Foreground="{StaticResource TodosDangerBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <controls:SvgIcon Width="15" Height="14" Source="Assets/Icons/exit.svg"
                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                            <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="Salir" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <TextBlock Margin="11,4,11,3" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                               Foreground="#8B6170" FontSize="10.5" />
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="HiddenListsPopup"
               PlacementTarget="{Binding ElementName=HiddenListsButton}"
               DataContext="{Binding DataContext, ElementName=HiddenListsButton}"
               IsOpen="{Binding IsHiddenSubmenuOpen, Mode=TwoWay}"
               Placement="Left" HorizontalOffset="-9"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="238" Padding="8" Background="{StaticResource TodosPopupBrush}"
                    BorderBrush="#16000000" BorderThickness="1" CornerRadius="17">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="7" Opacity="0.22" Color="#302A3D" />
                </Border.Effect>
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding HiddenWindows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource HiddenListButtonStyle}"
                                                Command="{Binding ShowCommand}" ToolTip="Mostrar esta lista">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:SvgIcon Width="13" Height="11" Source="Assets/Icons/eye.svg"
                                                                  Foreground="{StaticResource TodosSecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center"
                                                           Text="{Binding Title}" Foreground="{StaticResource TodosTextBrush}"
                                                           FontSize="14" FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource HiddenDeleteButtonStyle}"
                                                Command="{Binding DeleteCommand}" ToolTip="Eliminar esta lista"
                                                automation:AutomationProperties.Name="Eliminar lista oculta">
                                            <controls:SvgIcon Width="13" Height="15" Source="Assets/Icons/trash.svg"
                                                              Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
