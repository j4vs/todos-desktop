<Window x:Class="Todos.Presentation.Views.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:controls="clr-namespace:Todos.Presentation.Controls"
        xmlns:converters="clr-namespace:Todos.Presentation.Converters"
        Title="Todo's" Width="{DynamicResource LauncherDiameter}" Height="{DynamicResource LauncherDiameter}" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Foreground="{StaticResource TodosTextBrush}" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontSize="{DynamicResource Font12}" FontFamily="{StaticResource TodosFontFamily}" WindowStartupLocation="Manual"
        PreviewKeyDown="OnWindowPreviewKeyDown" automation:AutomationProperties.Name="Todo's, control principal">
    <Window.Resources>
        <converters:TodoThemeBrushConverter x:Key="ThemeBrush" />
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="{DynamicResource Row42}" />
            <Setter Property="Padding" Value="{DynamicResource Space12_0}" />
            <Setter Property="Margin" Value="{DynamicResource Space0_2}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TodosTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource TodosFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource Font13}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="11">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosHoverSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosPressedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource TodosFocusBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosBrandHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Primary" />
                                    <Condition Property="IsPressed" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource TodosBrandPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#9285D8" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.65" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="StrokeThickness" Value="4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppearanceChoice" TargetType="RadioButton">
            <Setter Property="Margin" Value="{DynamicResource Space2}" /><Setter Property="Padding" Value="{DynamicResource Space10_8}" />
            <Setter Property="Foreground" Value="{StaticResource TodosTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ChoiceSurface" CornerRadius="9" Background="{StaticResource TodosHoverSurfaceBrush}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceSurface" Property="Background" Value="{StaticResource TodosBrandBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceSurface" Property="Opacity" Value="0.8" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="{StaticResource TodosFocusBrush}" /><Setter TargetName="ChoiceSurface" Property="BorderThickness" Value="1" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FloatingLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="{DynamicResource Font13}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid x:Name="LauncherRoot">
        <Border x:Name="LauncherSurface" Width="{DynamicResource LauncherDiameter}" Height="{DynamicResource LauncherDiameter}" Focusable="True" Background="Transparent"
                Cursor="Hand" automation:AutomationProperties.Name="{Binding LauncherTitle}"
                PreviewMouseLeftButtonDown="OnLauncherMouseDown" PreviewMouseMove="OnLauncherMouseMove"
                PreviewMouseLeftButtonUp="OnLauncherMouseUp" PreviewMouseRightButtonDown="OnLauncherRightClick"
                MouseEnter="OnLauncherMouseEnter" MouseLeave="OnLauncherMouseLeave">
            <Grid IsHitTestVisible="False">
                <Ellipse Margin="{DynamicResource Space1p5}" Fill="{Binding LauncherColor}" Stroke="White" StrokeThickness="2" />
                <controls:SvgIcon Width="{DynamicResource LauncherCheckWidth}" Height="{DynamicResource LauncherCheckHeight}" Source="Assets/Icons/check.svg" Foreground="White" />
            </Grid>
        </Border>
        <Popup x:Name="NamePopup" PlacementTarget="{Binding ElementName=LauncherSurface}" Placement="Custom"
               StaysOpen="True" AllowsTransparency="True" IsHitTestVisible="False">
            <Border Padding="{DynamicResource Space8_3}" Background="#E6302D3A" CornerRadius="6" MaxWidth="220">
                <TextBlock Text="{Binding LauncherTitle}" Style="{StaticResource FloatingLabelStyle}" />
            </Border>
        </Popup>
        <Popup x:Name="ButtonsPopup" PlacementTarget="{Binding ElementName=LauncherSurface}" Placement="Custom"
               StaysOpen="True" AllowsTransparency="True">
            <Border x:Name="ButtonsPanel" Width="240" Padding="{DynamicResource Space4}" Background="Transparent" Opacity="0">
                <Border.RenderTransform><TranslateTransform x:Name="PanelTranslation" /></Border.RenderTransform>
                <Grid>
                    <StackPanel x:Name="ActionsPanel" Visibility="Collapsed">
                        <Grid Margin="{DynamicResource Space0_3}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <Border Background="#E6302D3A" CornerRadius="6" Padding="{DynamicResource Space8_3}" Margin="{DynamicResource Space0_0_8_0}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="184">
                                <TextBlock Text="Salir" Style="{StaticResource FloatingLabelStyle}" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Command="{Binding ExitCommand}"
                                    ToolTip="Salir" automation:AutomationProperties.Name="Salir">
                                <controls:SvgIcon FlowDirection="LeftToRight" Width="21" Height="21" Source="Assets/Icons/exit.svg" Foreground="White" />
                            </Button>
                        </Grid>
                        <Grid Margin="{DynamicResource Space0_3}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <Border Background="#E6302D3A" CornerRadius="6" Padding="{DynamicResource Space8_3}" Margin="{DynamicResource Space0_0_8_0}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="184">
                                <TextBlock Text="Minimizar" Style="{StaticResource FloatingLabelStyle}" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Command="{Binding MinimizeCommand}"
                                    ToolTip="Minimizar botón" automation:AutomationProperties.Name="Minimizar botón">
                                <controls:SvgIcon FlowDirection="LeftToRight" Width="20" Height="20" Source="Assets/Icons/minimize.svg" Foreground="White" />
                            </Button>
                        </Grid>
                        <Grid Margin="{DynamicResource Space0_3}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <Border Background="#E6302D3A" CornerRadius="6" Padding="{DynamicResource Space8_3}" Margin="{DynamicResource Space0_0_8_0}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="184">
                                <TextBlock Text="Configuración" Style="{StaticResource FloatingLabelStyle}" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Click="OnSettingsClick"
                                    ToolTip="Configuración" automation:AutomationProperties.Name="Configuración">
                                <controls:SvgIcon FlowDirection="LeftToRight" Width="21" Height="21" Source="Assets/Icons/gear.svg" Foreground="White" />
                            </Button>
                        </Grid>
                        <Grid Margin="{DynamicResource Space0_3}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <Border Background="#E6302D3A" CornerRadius="6" Padding="{DynamicResource Space8_3}" Margin="{DynamicResource Space0_0_8_0}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="184">
                                <TextBlock Text="Papelera" Style="{StaticResource FloatingLabelStyle}" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Command="{Binding ShowTrashCommand}"
                                    ToolTip="Papelera" automation:AutomationProperties.Name="Papelera">
                                <controls:SvgIcon FlowDirection="LeftToRight" Width="19" Height="21" Source="Assets/Icons/trash.svg" Foreground="White" />
                            </Button>
                        </Grid>
                        <Grid Margin="{DynamicResource Space0_3}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                            <Border Background="#E6302D3A" CornerRadius="6" Padding="{DynamicResource Space8_3}" Margin="{DynamicResource Space0_0_8_0}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="184">
                                <TextBlock Text="Nueva lista" Style="{StaticResource FloatingLabelStyle}" FlowDirection="LeftToRight" />
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Command="{Binding CreateListCommand}"
                                    ToolTip="Nueva lista" automation:AutomationProperties.Name="Nueva lista">
                                <controls:SvgIcon FlowDirection="LeftToRight" Width="21" Height="21" Source="Assets/Icons/plus.svg" Foreground="White" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <ScrollViewer Style="{StaticResource TodosSlimScrollViewer}" x:Name="HiddenPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HiddenWindows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="{DynamicResource Space0_3}" PreviewMouseRightButtonDown="OnHiddenListRightClick" PreviewKeyDown="OnHiddenListKeyDown"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                        <Border Background="#E6302D3A" CornerRadius="6" Padding="{DynamicResource Space8_3}" Margin="{DynamicResource Space0_0_8_0}" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="174">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource FloatingLabelStyle}" FlowDirection="LeftToRight" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource CircleButtonStyle}" Background="{Binding ColorTheme, Converter={StaticResource ThemeBrush}, ConverterParameter=Launcher}"
                                                Command="{Binding ShowCommand}" ToolTip="{Binding Title}" automation:AutomationProperties.Name="{Binding Title}">
                                            <controls:SvgIcon Width="20" Height="17" Source="Assets/Icons/check.svg" Foreground="White" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
        <Popup x:Name="ListMenuPopup" Placement="Left" HorizontalOffset="-8" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="230" Padding="{DynamicResource Space10}" Background="{StaticResource TodosPopupBrush}" BorderBrush="#16000000" BorderThickness="1" CornerRadius="17">
                <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" FontSize="{DynamicResource Font15}" Margin="{DynamicResource Space10_6_10_8}" Foreground="{StaticResource TodosTextBrush}" />
                    <Button x:Name="MoveListToTrashButton" Style="{StaticResource MenuButtonStyle}" Click="OnMoveListToTrash" Foreground="{StaticResource TodosDangerBrush}">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Source="Assets/Icons/trash.svg" Width="15" Height="17" Foreground="{StaticResource TodosDangerBrush}" Margin="{DynamicResource Space0_0_9_0}" />
                            <TextBlock Text="Mover a papelera" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=LauncherSurface}" Placement="Custom"
               IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
            <Border MaxHeight="620" Width="370" Padding="{DynamicResource Space14}" Background="{StaticResource TodosPopupBrush}" BorderBrush="#16000000" BorderThickness="1" CornerRadius="19">
                <ScrollViewer Style="{StaticResource TodosSlimScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Configuración" FontSize="{DynamicResource Font18}" FontWeight="SemiBold" Foreground="{StaticResource TodosTextBrush}" Margin="{DynamicResource Space6_2_6_10}" />
                    <CheckBox Tag="Configuration" MinHeight="{DynamicResource Row40}" FontSize="{DynamicResource Font13}" VerticalContentAlignment="Center" Content="Iniciar Todo's con Windows" IsChecked="{Binding RunAtWindowsStartup}" Foreground="{StaticResource TodosTextBrush}" />
                    <CheckBox Tag="Configuration" MinHeight="{DynamicResource Row40}" FontSize="{DynamicResource Font13}" VerticalContentAlignment="Center" Content="Minimizar listas automáticamente" IsChecked="{Binding AutoMinimizeWindows}" Foreground="{StaticResource TodosTextBrush}" />
                    <TextBlock Text="Tamaño de letra" FontSize="{DynamicResource Font13}" FontWeight="Medium" Margin="{DynamicResource Space6_12_6_6}" />
                    <Grid Margin="{DynamicResource Space4_0}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button x:Name="SmallerFontButton" Style="{StaticResource MenuButtonStyle}" Content="−" Command="{Binding SmallerFontCommand}" ToolTip="Reducir letra" automation:AutomationProperties.Name="Reducir tamaño de letra" />
                        <TextBlock Grid.Column="1" Text="{Binding FontSizeLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{DynamicResource Font14}" />
                        <Button x:Name="LargerFontButton" Grid.Column="2" Style="{StaticResource MenuButtonStyle}" Content="+" Command="{Binding LargerFontCommand}" ToolTip="Aumentar letra" automation:AutomationProperties.Name="Aumentar tamaño de letra" />
                    </Grid>
                    <TextBlock Text="Tamaño del botón principal" FontSize="{DynamicResource Font13}" FontWeight="Medium" Margin="{DynamicResource Space6_12_6_6}" />
                    <UniformGrid Columns="3">
                        <RadioButton Style="{StaticResource AppearanceChoice}" GroupName="LauncherSize" Content="Chico" IsChecked="{Binding LauncherSmall}" />
                        <RadioButton Style="{StaticResource AppearanceChoice}" GroupName="LauncherSize" Content="Mediano" IsChecked="{Binding LauncherMedium}" />
                        <RadioButton Style="{StaticResource AppearanceChoice}" GroupName="LauncherSize" Content="Grande" IsChecked="{Binding LauncherLarge}" />
                    </UniformGrid>
                    <TextBlock Text="Espaciado general" FontSize="{DynamicResource Font13}" FontWeight="Medium" Margin="{DynamicResource Space6_12_6_6}" />
                    <UniformGrid Columns="3">
                        <RadioButton Style="{StaticResource AppearanceChoice}" GroupName="SpacingSize" Content="Chico" IsChecked="{Binding SpacingSmall}" />
                        <RadioButton Style="{StaticResource AppearanceChoice}" GroupName="SpacingSize" Content="Mediano" IsChecked="{Binding SpacingMedium}" />
                        <RadioButton Style="{StaticResource AppearanceChoice}" GroupName="SpacingSize" Content="Grande" IsChecked="{Binding SpacingLarge}" />
                    </UniformGrid>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource TodosDangerBrush}" FontSize="{DynamicResource Font11}" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</Window>
