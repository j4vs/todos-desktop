<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Todos.Presentation.Controls">
    <Style TargetType="ToolTip">
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Foreground" Value="{DynamicResource TodosPopupBrush}" />
        <Setter Property="Background" Value="{DynamicResource TodosTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource TodosFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="True" />
    </Style>

    <Style x:Key="TodosFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2"
                            BorderBrush="{DynamicResource TodosFocusBrush}"
                            BorderThickness="2"
                            CornerRadius="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TodosFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{StaticResource TodosFontFamily}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TodosFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{StaticResource TodosFontFamily}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TodosFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{StaticResource TodosFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="CheckSurface" Background="Transparent" CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:SvgIcon x:Name="CheckIcon"
                                              Width="17" Height="17"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Source="Assets/Icons/checkbox.svg"
                                              Foreground="{DynamicResource TodosSecondaryTextBrush}" />
                            <ContentPresenter Grid.Column="1"
                                              Margin="7,0,0,0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckIcon" Property="Source" Value="Assets/Icons/checkbox-checked.svg" />
                            <Setter TargetName="CheckIcon" Property="Foreground" Value="{DynamicResource TodosBrandBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckSurface" Property="Background" Value="{DynamicResource TodosHoverSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckSurface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
